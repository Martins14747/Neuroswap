# Copy to .env for local development (never commit .env)

# Server
PORT=8000

# Optional API key — required on protected endpoints when set
# NEUROSWAP_API_KEY=your-secret-key

# Persistent data root (uploads, videos, outputs, model cache)
# NEUROSWAP_DATA_DIR=/app/data

# InsightFace model directory (auto-set when NEUROSWAP_DATA_DIR is used)
# INSIGHTFACE_ROOT=/app/data/.insightface_models

# Comma-separated origins for CORS (needed if frontend is on another domain)
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# Serve uploaded target thumbnails at /uploads/*
# NEUROSWAP_SERVE_UPLOADS=1

# Max video upload size in bytes (default 1 GB)
# MAX_VIDEO_UPLOAD_BYTES=1073741824

# Render / split-deploy: public API URL injected into frontend (optional)
# NEUROSWAP_PUBLIC_API_URL=https://neuroswap.onrender.com
# NEUROSWAP_PUBLIC_WS_URL=wss://neuroswap.onrender.com

# Storage backend
# NEUROSWAP_STORAGE=local
# NEUROSWAP_STORAGE=s3
# NEUROSWAP_S3_BUCKET=your-private-bucket
# NEUROSWAP_S3_PREFIX=neuroswap
# NEUROSWAP_S3_RESTORE_LIMIT=20
