{
  "$schema": "https://openapi.vercel.com/vercel.json",
  "version": 2,
  "installCommand": "pip install -r requirements.txt",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 3008
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "env": {
    "NEUROSWAP_DEPLOYMENT": "vercel"
  }
}
